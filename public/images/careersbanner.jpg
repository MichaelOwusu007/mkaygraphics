<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="50%" style="stop-color:#16213e"/>
      <stop offset="100%" style="stop-color:#0f3460"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#f59e0b"/>
      <stop offset="100%" style="stop-color:#d97706"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="600" fill="url(#bg)"/>
  <circle cx="150" cy="100" r="180" fill="#f59e0b" opacity="0.1"/>
  <circle cx="1050" cy="500" r="200" fill="#f59e0b" opacity="0.08"/>
  <rect x="400" y="180" width="60" height="180" rx="30" fill="url(#accent)"/>
  <rect x="480" y="220" width="60" height="140" rx="30" fill="#f59e0b" opacity="0.7"/>
  <rect x="560" y="260" width="60" height="100" rx="30" fill="#f59e0b" opacity="0.4"/>
  <rect x="640" y="200" width="60" height="160" rx="30" fill="#f59e0b" opacity="0.6"/>
  <rect x="720" y="240" width="60" height="120" rx="30" fill="#f59e0b" opacity="0.5"/>
  <circle cx="600" cy="450" r="40" fill="none" stroke="url(#accent)" stroke-width="3"/>
  <circle cx="600" cy="450" r="60" fill="none" stroke="url(#accent)" stroke-width="2" opacity="0.5"/>
  <circle cx="600" cy="450" r="80" fill="none" stroke="url(#accent)" stroke-width="1" opacity="0.3"/>
  <rect x="550" y="420" width="100" height="60" rx="10" fill="url(#accent)"/>
</svg>