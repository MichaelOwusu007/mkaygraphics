<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <!-- Background -->
  <rect width="800" height="500" fill="#1a1a2e"/>
  
  <!-- Gradient overlay -->
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e"/>
      <stop offset="100%" style="stop-color:#16213e"/>
    </linearGradient>
  </defs>
  <rect width="800" height="500" fill="url(#bgGrad)"/>
  
  <!-- Abstract shapes representing photo editing -->
  <circle cx="200" cy="200" r="100" fill="#9b59b6" opacity="0.6"/>
  <circle cx="220" cy="180" r="80" fill="#8e44ad" opacity="0.4"/>
  
  <!-- Before/After effect -->
  <rect x="50" y="100" width="200" height="300" rx="10" fill="#34495e"/>
  <text x="150" y="420" font-family="Arial" font-size="14" fill="#95a5a6" text-anchor="middle">Before</text>
  
  <!-- After version (brighter) -->
  <rect x="300" y="100" width="200" height="300" rx="10" fill="#ecf0f1"/>
  <circle cx="400" cy="200" r="80" fill="#9b59b6" opacity="0.8"/>
  <text x="400" y="420" font-family="Arial" font-size="14" fill="#2c3e50" text-anchor="middle">After</text>
  
  <!-- Editing tools -->
  <rect x="550" y="150" width="200" height="8" rx="2" fill="#e74c3c"/>
  <rect x="550" y="180" width="150" height="8" rx="2" fill="#2ecc71"/>
  <rect x="550" y="210" width="180" height="8" rx="2" fill="#3498db"/>
  <rect x="550" y="240" width="120" height="8" rx="2" fill="#f1c40f"/>
  
  <!-- Sliders -->
  <circle cx="560" cy="300" r="8" fill="#fff"/>
  <rect x="550" y="296" width="150" height="8" rx="4" fill="#555"/>
  
  <circle cx="560" cy="340" r="8" fill="#fff"/>
  <rect x="550" y="336" width="100" height="8" rx="4" fill="#555"/>
  
  <circle cx="560" cy="380" r="8" fill="#fff"/>
  <rect x="550" y="376" width="130" height="8" rx="4" fill="#555"/>
  
  <!-- Color adjustments -->
  <circle cx="700" cy="150" r="40" fill="#e74c3c" opacity="0.8"/>
  <circle cx="720" cy="180" r="30" fill="#2ecc71" opacity="0.6"/>
  <circle cx="680" cy="190" r="25" fill="#3498db" opacity="0.7"/>
  
  <!-- Magic wand -->
  <rect x="600" y="420" width="100" height="4" rx="2" fill="#f39c12" transform="rotate(-45 650 422)"/>
  <polygon points="520,480 540,440 560,480 540,470" fill="#f39c12"/>
  
  <text x="400" y="470" font-family="Arial" font-size="24" fill="#fff" text-anchor="middle">Transform Your Photos</text>
</svg>
