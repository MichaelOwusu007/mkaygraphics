<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">
  <!-- Background -->
  <rect width="800" height="500" fill="#fdf2f8"/>
  
  <!-- Decorative pattern (kente-inspired) -->
  <defs>
    <pattern id="kente" patternUnits="userSpaceOnUse" width="40" height="40">
      <rect width="20" height="20" fill="#f59e0b"/>
      <rect x="20" width="20" height="20" fill="#16a34a"/>
      <rect y="20" width="20" height="20" fill="#dc2626"/>
      <rect x="20" y="20" width="20" height="20" fill="#2563eb"/>
    </pattern>
  </defs>
  
  <!-- Wedding invitation cards stack -->
  <g transform="translate(100, 80)">
    <!-- Back cards -->
    <rect x="20" y="20" width="250" height="320" rx="8" fill="#e5e7eb" stroke="#9ca3af" stroke-width="1"/>
    <rect x="10" y="10" width="250" height="320" rx="8" fill="#f3f4f6" stroke="#9ca3af" stroke-width="1"/>
    
    <!-- Main invitation card -->
    <rect x="0" y="0" width="280" height="350" rx="10" fill="white" stroke="#d4af37" stroke-width="3"/>
    <rect x="20" y="20" width="240" height="310" rx="5" fill="none" stroke="#d4af37" stroke-width="1"/>
    
    <!-- Decorative corner -->
    <rect x="20" y="20" width="40" height="40" fill="url(#kente)" opacity="0.3"/>
    <rect x="220" y="20" width="40" height="40" fill="url(#kente)" opacity="0.3"/>
    <rect x="20" y="290" width="40" height="40" fill="url(#kente)" opacity="0.3"/>
    <rect x="220" y="290" width="40" height="40" fill="url(#kente)" opacity="0.3"/>
    
    <!-- Ring icon -->
    <circle cx="140" cy="100" r="35" fill="none" stroke="#d4af37" stroke-width="4"/>
    <circle cx="155" cy="90" r="12" fill="none" stroke="#d4af37" stroke-width="4"/>
    
    <!-- Text placeholder -->
    <rect x="80" y="160" width="120" height="4" rx="2" fill="#d4af37"/>
    <rect x="60" y="180" width="160" height="3" rx="1" fill="#9ca3af"/>
    <rect x="70" y="195" width="140" height="3" rx="1" fill="#9ca3af"/>
    <rect x="50" y="220" width="180" height="4" rx="2" fill="#d4af37"/>
    <rect x="90" y="250" width="100" height="3" rx="1" fill="#9ca3af"/>
    <rect x="80" y="270" width="120" height="3" rx="1" fill="#9ca3af"/>
  </g>
  
  <!-- Second card (program) -->
  <g transform="translate(420, 120)">
    <rect x="0" y="0" width="220" height="300" rx="8" fill="white" stroke="#10b981" stroke-width="2"/>
    <rect x="15" y="15" width="190" height="270" rx="4" fill="none" stroke="#10b981" stroke-width="1"/>
    
    <!-- Program lines -->
    <rect x="40" y="50" width="140" height="5" rx="2" fill="#10b981"/>
    <rect x="30" y="80" width="160" height="2" rx="1" fill="#d1d5db"/>
    <rect x="30" y="100" width="150" height="2" rx="1" fill="#d1d5db"/>
    <rect x="30" y="120" width="155" height="2" rx="1" fill="#d1d5db"/>
    <rect x="30" y="140" width="140" height="2" rx="1" fill="#d1d5db"/>
    <rect x="30" y="160" width="160" height="2" rx="1" fill="#d1d5db"/>
    <rect x="30" y="180" width="145" height="2" rx="1" fill="#d1d5db"/>
    
    <rect x="60" y="220" width="100" height="4" rx="2" fill="#10b981"/>
    <rect x="50" y="250" width="120" height="3" rx="1" fill="#9ca3af"/>
  </g>
  
  <!-- Flower decorations -->
  <circle cx="380" cy="80" r="20" fill="#ec4899" opacity="0.6"/>
  <circle cx="395" cy="95" r="15" fill="#f472b6" opacity="0.5"/>
  <circle cx="700" cy="400" r="25" fill="#ec4899" opacity="0.5"/>
  <circle cx="720" cy="420" r="18" fill="#f472b6" opacity="0.4"/>
  
  <!-- Text -->
  <text x="400" y="480" font-family="Georgia" font-size="22" fill="#7c3aed" text-anchor="middle">Essential Wedding Stationery</text>
</svg>
