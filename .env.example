# Application
APP_URL=http://localhost:3000

# Paystack
# Keep both values server-only. Do not rename them with a NEXT_PUBLIC_ prefix.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Nodemailer SMTP
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=465
NODEMAILER_SECURE=true
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
NODEMAILER_RECEIVER=
NODEMAILER_FROM_NAME="MkayGraphics & Photography"
